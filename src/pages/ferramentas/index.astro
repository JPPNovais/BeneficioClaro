---
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/core/Card.astro";
import SectionTitle from "@components/content/SectionTitle.astro";
import Icon from "@components/Icon.astro";
import { SITE } from "@config/site";
import { urlAbsoluta } from "@lib/utils";
import { itemListSchema } from "@lib/seo";
import { FERRAMENTAS, GRUPOS_FERRAMENTAS, ferramentasDoGrupo } from "@config/ferramentas";

const grupos = GRUPOS_FERRAMENTAS.map((g) => ({ ...g, ferramentas: ferramentasDoGrupo(g.grupo) })).filter(
  (g) => g.ferramentas.length > 0
);

const schema = [
  itemListSchema(
    FERRAMENTAS.map((t) => ({ name: t.title, url: urlAbsoluta(Astro.site ?? SITE.url, t.href) }))
  ),
];
---

<BaseLayout
  title="Calculadoras gratuitas"
  description="Calculadoras de salário líquido e FGTS, simulador de benefícios, calendário por NIS e checklist de documentos. Com a memória de cálculo aberta e rodando no seu aparelho."
  canonical="/ferramentas"
  schema={schema}
>
  <div class="max-w-container mx-auto px-4 pt-9">
    <div class="max-w-prose mb-7">
      <div class="text-[13px] font-bold tracking-[0.06em] uppercase text-green-600 mb-0.5">Grátis</div>
      <h1 class="mt-0 mb-2">Calculadoras e ferramentas</h1>
      <p class="text-lg text-ink-600 m-0">
        Tudo funciona direto no seu celular, de graça e sem cadastro. Nada do que você digita é enviado
        ou salvo — e a <a href="/metodologia" class="font-semibold text-green-700">metodologia de cada
        cálculo</a> fica pública, com a fórmula e a base legal.
      </p>
    </div>

    {
      grupos.map((g, i) => (
        <section class={i > 0 ? "mt-10" : ""}>
          <SectionTitle eyebrow={g.descricao} title={g.titulo} />
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {g.ferramentas.map((t) => (
              <Card interactive href={t.href} padding="lg">
                <div class="flex flex-col gap-2 h-full">
                  <span
                    class={`w-14 h-14 rounded-md flex items-center justify-center ${t.tone === "cta" ? "bg-orange-100 text-orange-700" : "bg-green-100 text-green-700"}`}
                  >
                    <Icon name={t.icon} size={30} />
                  </span>
                  <h3 class="mt-2 mb-0 text-xl">{t.title}</h3>
                  <p class="m-0 text-base text-ink-600">{t.description}</p>
                  <span class="mt-auto pt-3 inline-flex items-center gap-1.5 text-green-700 font-bold">
                    Abrir ferramenta <Icon name="arrow-right" size={18} />
                  </span>
                </div>
              </Card>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
