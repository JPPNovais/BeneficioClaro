---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/core/Card.astro";
import Button from "@components/core/Button.astro";
import ArticleCard from "@components/content/ArticleCard.astro";
import SectionTitle from "@components/content/SectionTitle.astro";
import Icon from "@components/Icon.astro";
import { SITE } from "@config/site";
import { CATEGORIAS, getCategoria, type Categoria } from "@config/categorias";
import { ferramentasDoGrupo, type Ferramenta } from "@config/ferramentas";
import { formatarDataCurta, tempoLeitura, urlArtigo, urlAbsoluta } from "@lib/utils";
import { breadcrumbSchema, itemListSchema } from "@lib/seo";

export async function getStaticPaths() {
  const artigos = await getCollection("artigos", ({ data }) => !data.draft);
  return CATEGORIAS.map((cat) => {
    // Artigos das categorias irmãs, agrupados por categoria e na ordem de `irmas`.
    const irmas = (cat.irmas ?? [])
      .map((slug) => ({
        cat: getCategoria(slug),
        artigos: artigos.filter((a) => a.data.categoria === slug),
      }))
      .filter((g): g is { cat: Categoria; artigos: CollectionEntry<"artigos">[] } =>
        !!g.cat && g.artigos.length > 0
      );

    return {
      params: { categoria: cat.slug },
      props: {
        cat,
        artigos: artigos.filter((a) => a.data.categoria === cat.slug),
        irmas,
      },
    };
  });
}

interface Props {
  cat: Categoria;
  artigos: CollectionEntry<"artigos">[];
  irmas: { cat: Categoria; artigos: CollectionEntry<"artigos">[] }[];
}
const { cat, artigos, irmas } = Astro.props;

const cardOf = (e: CollectionEntry<"artigos">, rotulo = cat.rotulo) => ({
  title: e.data.title,
  href: urlArtigo(e.data.categoria, e.slug),
  category: rotulo,
  readingTime: tempoLeitura(e.body),
  date: formatarDataCurta(e.data.dataAtualizacao),
  cover: e.data.capa,
  coverAlt: e.data.capaAlt,
});

// Agrupa artigos por subtópico (para a página-pilar)
const porSubtopico = (key: string) => artigos.filter((a) => a.data.subtopico === key);

const ehPilar = cat.pilar && !!cat.subtopicos;

/**
 * Só renderizamos (no índice e nas seções) os subtópicos que já têm artigo.
 * Um pilar novo mostraria "conteúdo em breve" várias vezes — página fina, ruim
 * para o leitor e para a análise do AdSense. Conforme os artigos são publicados,
 * cada subtópico aparece sozinho.
 */
const subtopicos = (cat.subtopicos ?? []).filter((s) => porSubtopico(s.key).length > 0);

// Ferramentas do silo, destacadas no topo do pilar (tool-first).
const ferramentas: Ferramenta[] = cat.ferramentasGrupo ? ferramentasDoGrupo(cat.ferramentasGrupo) : [];
const ctaFerramenta = ferramentas[0];

/**
 * A página só é `noindex` quando não tem absolutamente nada a oferecer. Um pilar
 * recém-criado, ainda sem artigos próprios, já é útil pelas ferramentas e pelos
 * artigos das categorias irmãs — e por isso deve ser indexado.
 */
const semConteudo = artigos.length === 0 && irmas.length === 0 && ferramentas.length === 0;

const site = Astro.site ?? SITE.url;
const schema = [
  breadcrumbSchema([
    { name: "Início", url: urlAbsoluta(site, "/") },
    { name: cat.nome, url: urlAbsoluta(site, `/${cat.slug}`) },
  ]),
  ...(ferramentas.length > 0
    ? [itemListSchema(ferramentas.map((f) => ({ name: f.title, url: urlAbsoluta(site, f.href) })))]
    : []),
];

const descricao = cat.heroDescricao ?? `Artigos e guias sobre ${cat.nome} em linguagem simples, com fontes oficiais.`;
---

<BaseLayout
  title={cat.heroTitulo ?? cat.nome}
  description={descricao}
  canonical={`/${cat.slug}`}
  noindex={semConteudo}
  schema={schema}
>
  {
    ehPilar ? (
      <!-- ===== Página-pilar ===== -->
      <section class="bg-green-900 text-white">
        <div class="max-w-prose mx-auto px-4 pt-11 pb-10">
          <span class="inline-flex items-center gap-1.5 px-3 py-[5px] rounded-pill bg-white/10 text-green-200 text-sm font-bold mb-4">
            <Icon name="book-open" size={16} /> {cat.heroEyebrow}
          </span>
          <h1 class="text-white m-0 mb-3" style="font-size:clamp(2rem,6vw,2.75rem)">{cat.heroTitulo}</h1>
          <p class="text-green-100 text-lg m-0 max-w-[560px]">{cat.heroDescricao}</p>
        </div>
      </section>

      <div class="max-w-container mx-auto px-4 pt-8">
        <!-- Ferramentas do silo — tool-first: a conta antes do texto -->
        {ferramentas.length > 0 && (
          <section class="mb-9">
            <SectionTitle eyebrow="Faça a conta" title="Calculadoras deste guia" />
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {ferramentas.map((f) => (
                <Card interactive href={f.href} padding="md">
                  <div class="flex flex-col gap-2 h-full">
                    <span
                      class={`w-12 h-12 rounded-md flex items-center justify-center ${f.tone === "cta" ? "bg-orange-100 text-orange-700" : "bg-green-100 text-green-700"}`}
                    >
                      <Icon name={f.icon} size={26} />
                    </span>
                    <h3 class="mt-1 mb-0 text-lg">{f.short ?? f.title}</h3>
                    <p class="m-0 text-[15px] text-ink-600">{f.description}</p>
                    <span class="mt-auto pt-2.5 inline-flex items-center gap-1.5 text-green-700 font-bold text-[15px]">
                      Abrir ferramenta <Icon name="arrow-right" size={18} />
                    </span>
                  </div>
                </Card>
              ))}
            </div>
          </section>
        )}

        <!-- Índice navegável -->
        {subtopicos.length > 0 && (
          <Card padding="md" class="mb-8">
            <div class="text-[13px] font-bold tracking-[0.06em] uppercase text-green-600 mb-2.5">
              Conteúdo deste guia
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
              {subtopicos.map((s) => (
                <a
                  href={`#${s.key}`}
                  class="flex items-center gap-2 p-3 rounded-md bg-green-50 no-underline text-green-800 font-semibold min-h-control-min hover:bg-green-100"
                >
                  <Icon name={s.icon} size={20} color="#0A5446" />
                  {s.title}
                </a>
              ))}
            </div>
          </Card>
        )}

        <!-- Blocos de subtópico -->
        {subtopicos.map((s) => (
          <section id={s.key} class="mb-9 scroll-mt-24">
            <div class="flex items-center gap-3 mb-3.5">
              <span class="w-12 h-12 rounded-md bg-green-100 text-green-700 flex items-center justify-center flex-none">
                <Icon name={s.icon} size={26} />
              </span>
              <div>
                <h2 class="m-0">{s.title}</h2>
                <p class="mt-0.5 mb-0 text-ink-600 text-base">{s.desc}</p>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {porSubtopico(s.key).map((e) => <ArticleCard {...cardOf(e)} />)}
            </div>
          </section>
        ))}

        <!-- Artigos das categorias irmãs do mesmo silo -->
        {irmas.length > 0 && (
          <section class="mb-9 pt-2 border-t border-ink-200">
            <SectionTitle
              eyebrow="No mesmo assunto"
              title={cat.irmasTitulo ?? `Também em ${cat.nome}`}
              class="mt-6"
            />
            {irmas.map((g) => (
              <div class="mb-6">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <h3 class="m-0 text-lg">{g.cat.nome}</h3>
                  <a href={`/${g.cat.slug}`} class="text-green-700 font-bold text-[15px] no-underline hover:underline">
                    Ver todos
                  </a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                  {g.artigos.map((e) => <ArticleCard {...cardOf(e, g.cat.rotulo)} />)}
                </div>
              </div>
            ))}
          </section>
        )}

        {ctaFerramenta && (
          <Card padding="lg" class="bg-green-50 border border-green-200 text-center mb-2">
            <h3 class="mt-0 mb-1.5">Não sabe por onde começar?</h3>
            <p class="mt-0 mb-4 text-ink-600">{ctaFerramenta.description}</p>
            <Button variant="cta" size="lg" href={ctaFerramenta.href}>
              Abrir a ferramenta
              <Icon name="arrow-right" size={20} slot="trailing" />
            </Button>
          </Card>
        )}
      </div>
    ) : (
      <!-- ===== Listagem de categoria (não-pilar) ===== -->
      <div class="max-w-container mx-auto px-4 pt-8">
        <div class="max-w-prose mb-7">
          <h1 class="mb-2">{cat.nome}</h1>
          <p class="text-lg text-ink-600 m-0">{descricao}</p>
        </div>
        {semConteudo ? (
          <Card padding="lg" class="text-center">
            <span class="inline-flex w-14 h-14 rounded-pill bg-green-100 text-green-700 items-center justify-center mb-2">
              <Icon name="book-open" size={28} />
            </span>
            <h3 class="mt-1 mb-1.5">Conteúdo em breve</h3>
            <p class="m-0 mb-4 text-ink-600">Ainda estamos preparando os artigos sobre {cat.nome}.</p>
            <Button variant="secondary" href="/">Voltar para a página inicial</Button>
          </Card>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {artigos.map((e) => <ArticleCard {...cardOf(e)} />)}
          </div>
        )}
      </div>
    )
  }
</BaseLayout>
